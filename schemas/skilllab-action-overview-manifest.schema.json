{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillLab 动作总览 manifest v1",
  "type": "object",
  "required": ["schemaVersion", "generator", "engine", "generatedUtc", "batchId", "generationId", "asset", "outputRoot", "directory", "status", "visualVerification", "playbackMapping", "optionalOverlays"],
  "properties": {
    "schemaVersion": {"const": 1},
    "generator": {"const": "SkillLabActionOverview/1"},
    "engine": {"type": "string"},
    "generatedUtc": {"type": "string"},
    "batchId": {"type": "string", "minLength": 1},
    "generationId": {"type": "string", "minLength": 1},
    "asset": {"type": "string", "minLength": 1},
    "outputRoot": {"type": "string", "minLength": 1},
    "directory": {"type": "string", "minLength": 1},
    "status": {"enum": ["running", "failed", "metadataOnly", "framesReady", "complete"]},
    "visualVerification": {"const": "pendingIndependentInspection"},
    "playbackMapping": {"const": "sourceOnly_notEstablished"},
    "optionalOverlays": {"type": "string"},
    "skeleton": {"type": "string"},
    "mesh": {"type": "string"},
    "meshSource": {"enum": ["explicitOverride", "animationSavedPreview", "skeletonSavedPreview"]},
    "inputs": {
      "type": "array", "minItems": 3,
      "items": {"type": "object", "required": ["object", "class", "packageDirty", "file", "md5"], "properties": {
        "md5": {"type": "string", "pattern": "^[a-fA-F0-9]{32}$"},
        "packageDirty": {"const": false}
      }}
    },
    "timing": {
      "type": "object",
      "required": ["numerator", "denominator", "intervalCount", "sampleCount", "durationSeconds", "frameRule", "poseEvaluation", "targetRateNumerator", "targetRateDenominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 1},
        "denominator": {"type": "integer", "minimum": 1},
        "intervalCount": {"type": "integer", "minimum": 0},
        "sampleCount": {"type": "integer", "minimum": 1, "maximum": 100000},
        "durationSeconds": {"type": "number", "minimum": 0}
      }
    },
    "frames": {
      "type": "array",
      "items": {"type": "object", "required": ["frame", "seconds", "sourceRootLocal", "status"], "properties": {
        "frame": {"type": "integer", "minimum": 0},
        "seconds": {"type": "number", "minimum": 0},
        "status": {"enum": ["notRendered", "rendered"]},
        "boneRevision": {"type": "integer", "minimum": 0},
        "renderFrameIdentity": {"type": "integer", "minimum": 0},
        "sourceRootLocal": {"$ref": "#/$defs/transform"},
        "page": {"type": "integer", "minimum": 0},
        "row": {"type": "integer", "minimum": 0, "maximum": 2},
        "column": {"type": "integer", "minimum": 0, "maximum": 3},
        "sha256": {"$ref": "#/$defs/sha256"}
      }}
    },
    "pages": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["page", "image", "firstFrame", "lastFrame", "width", "height", "sha256"], "properties": {
        "sha256": {"$ref": "#/$defs/sha256"}
      }}
    },
    "rootMotion": {"type": "object", "required": ["enabled", "forceRootLock", "rootLockMode", "scope", "extractedRangeDelta"]},
    "preview": {"type": "object", "required": ["view", "rhi", "width", "height", "projection", "orthoWidthCm", "locationCm", "rotationPitchYawRoll", "reference", "boundsCheck"]},
    "layout": {"type": "object", "required": ["columns", "rows", "headerPixels", "labelPixels", "indexBase", "pageCount"]},
    "error": {"type": "object", "required": ["stage", "reason", "frame"]}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "complete"}}},
    "then": {"required": ["skeleton", "mesh", "meshSource", "inputs", "timing", "frames", "pages", "rootMotion", "preview", "layout", "inputPreviewFingerprintSha256"]}
  }, {
    "if": {"properties": {"status": {"const": "failed"}}},
    "then": {"required": ["error"]}
  }],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "vector": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "transform": {"type": "object", "required": ["translationCm", "rotationXYZW", "scale"], "properties": {
      "translationCm": {"$ref": "#/$defs/vector"},
      "rotationXYZW": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
      "scale": {"$ref": "#/$defs/vector"}
    }}
  }
}
